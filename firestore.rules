rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default deny all unspecified collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidOptionalString(data, field, maxLen) {
      return !(field in data) || data[field] == null || (data[field] is string && data[field].size() <= maxLen);
    }

    function isValidTimestamp(data, field) {
      return !(field in data) || (data[field] is timestamp && data[field] <= request.time);
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.email is string && data.email.size() <= 200 &&
             isValidOptionalString(data, 'displayName', 100) &&
             isValidOptionalString(data, 'storeName', 100) &&
             isValidOptionalString(data, 'promoCodesJson', 16000) &&
             isValidTimestamp(data, 'updatedAt');
    }

    function isValidProduct(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() > 0 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.costPriceMinor is int && data.costPriceMinor >= 0 &&
             data.sellPriceMinor is int && data.sellPriceMinor >= 0 &&
             isValidOptionalString(data, 'barcode', 100) &&
             isValidTimestamp(data, 'updatedAt');
    }

    function isValidSale(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() > 0 &&
             data.totalMinor is int && data.totalMinor >= 0 &&
             data.paymentMethod is string && data.paymentMethod.size() > 0 && data.paymentMethod.size() <= 50 &&
             isValidTimestamp(data, 'updatedAt');
    }

    function isValidSaleItem(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() > 0 &&
             data.saleId is string && data.saleId.size() > 0 && data.saleId.size() <= 128 &&
             data.productId is int &&
             data.productNameSnapshot is string && data.productNameSnapshot.size() > 0 && data.productNameSnapshot.size() <= 200 &&
             data.unitPriceMinor is int &&
             data.quantity is int &&
             data.lineTotalMinor is int &&
             isValidTimestamp(data, 'updatedAt');
    }

    function isValidPayment(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() > 0 &&
             data.saleId is string && data.saleId.size() > 0 && data.saleId.size() <= 128 &&
             data.method is string && data.method.size() > 0 && data.method.size() <= 50 &&
             data.tenderedMinor is int &&
             isValidTimestamp(data, 'updatedAt');
    }

    function isValidCustomer(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() > 0 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             (!('currentDebtMinor' in data) || data.currentDebtMinor is int) &&
             isValidTimestamp(data, 'updatedAt');
    }

    function isValidDebtTransaction(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() > 0 &&
             data.customerId is int &&
             data.type is string && data.type.size() > 0 && data.type.size() <= 50 &&
             data.amountMinor is int &&
             isValidTimestamp(data, 'updatedAt');
    }

    function isValidSupplier(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() > 0 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             isValidTimestamp(data, 'updatedAt');
    }

    function isValidPurchase(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() > 0 &&
             data.productId is int &&
             data.productName is string && data.productName.size() > 0 && data.productName.size() <= 200 &&
             data.quantity is int &&
             data.totalCostMinor is int &&
             isValidTimestamp(data, 'updatedAt');
    }

    function isValidReturnTransaction(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() > 0 &&
             data.saleId is string && data.saleId.size() > 0 && data.saleId.size() <= 128 &&
             data.returnedAmountMinor is int &&
             isValidTimestamp(data, 'updatedAt');
    }

    function isValidShiftReport(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() > 0 &&
             data.cashierName is string && data.cashierName.size() > 0 && data.cashierName.size() <= 100 &&
             data.openTimeEpochMs is int &&
             isValidTimestamp(data, 'updatedAt');
    }

    function isValidStockMovement(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() > 0 &&
             data.productId is int &&
             data.movementType is string && data.movementType.size() > 0 && data.movementType.size() <= 50 &&
             data.quantityChange is int &&
             isValidTimestamp(data, 'updatedAt');
    }

    function isValidReceiptTemplate(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.templateId is int &&
             data.userId is string && data.userId.size() > 0 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             (!('paperWidthDots' in data) || data.paperWidthDots is int) &&
             isValidTimestamp(data, 'updatedAt');
    }

    // User Profile & Store Config
    match /users/{userId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId && incoming().userId == request.auth.uid && isValidUserProfile(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidUserProfile(incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && request.auth.uid == userId;

      match /products/{productId} {
        allow get: if isSignedIn() && request.auth.uid == userId && isValidId(productId);
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(productId) && incoming().userId == request.auth.uid && isValidProduct(incoming());
        allow update: if isSignedIn() && request.auth.uid == userId && isValidId(productId) && isValidProduct(incoming()) && incoming().userId == existing().userId;
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(productId);
      }

      match /sales/{saleId} {
        allow get: if isSignedIn() && request.auth.uid == userId && isValidId(saleId);
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(saleId) && incoming().userId == request.auth.uid && isValidSale(incoming());
        allow update: if isSignedIn() && request.auth.uid == userId && isValidId(saleId) && isValidSale(incoming()) && incoming().userId == existing().userId;
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(saleId);
      }

      match /sale_items/{itemId} {
        allow get: if isSignedIn() && request.auth.uid == userId && isValidId(itemId);
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(itemId) && incoming().userId == request.auth.uid && isValidSaleItem(incoming());
        allow update: if isSignedIn() && request.auth.uid == userId && isValidId(itemId) && isValidSaleItem(incoming()) && incoming().userId == existing().userId;
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(itemId);
      }

      match /payments/{paymentId} {
        allow get: if isSignedIn() && request.auth.uid == userId && isValidId(paymentId);
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(paymentId) && incoming().userId == request.auth.uid && isValidPayment(incoming());
        allow update: if isSignedIn() && request.auth.uid == userId && isValidId(paymentId) && isValidPayment(incoming()) && incoming().userId == existing().userId;
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(paymentId);
      }

      match /customers/{customerId} {
        allow get: if isSignedIn() && request.auth.uid == userId && isValidId(customerId);
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(customerId) && incoming().userId == request.auth.uid && isValidCustomer(incoming());
        allow update: if isSignedIn() && request.auth.uid == userId && isValidId(customerId) && isValidCustomer(incoming()) && incoming().userId == existing().userId;
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(customerId);
      }

      match /debt_transactions/{txId} {
        allow get: if isSignedIn() && request.auth.uid == userId && isValidId(txId);
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(txId) && incoming().userId == request.auth.uid && isValidDebtTransaction(incoming());
        allow update: if isSignedIn() && request.auth.uid == userId && isValidId(txId) && isValidDebtTransaction(incoming()) && incoming().userId == existing().userId;
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(txId);
      }

      match /suppliers/{supplierId} {
        allow get: if isSignedIn() && request.auth.uid == userId && isValidId(supplierId);
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(supplierId) && incoming().userId == request.auth.uid && isValidSupplier(incoming());
        allow update: if isSignedIn() && request.auth.uid == userId && isValidId(supplierId) && isValidSupplier(incoming()) && incoming().userId == existing().userId;
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(supplierId);
      }

      match /purchases/{purchaseId} {
        allow get: if isSignedIn() && request.auth.uid == userId && isValidId(purchaseId);
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(purchaseId) && incoming().userId == request.auth.uid && isValidPurchase(incoming());
        allow update: if isSignedIn() && request.auth.uid == userId && isValidId(purchaseId) && isValidPurchase(incoming()) && incoming().userId == existing().userId;
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(purchaseId);
      }

      match /return_transactions/{returnId} {
        allow get: if isSignedIn() && request.auth.uid == userId && isValidId(returnId);
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(returnId) && incoming().userId == request.auth.uid && isValidReturnTransaction(incoming());
        allow update: if isSignedIn() && request.auth.uid == userId && isValidId(returnId) && isValidReturnTransaction(incoming()) && incoming().userId == existing().userId;
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(returnId);
      }

      match /shifts/{shiftId} {
        allow get: if isSignedIn() && request.auth.uid == userId && isValidId(shiftId);
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(shiftId) && incoming().userId == request.auth.uid && isValidShiftReport(incoming());
        allow update: if isSignedIn() && request.auth.uid == userId && isValidId(shiftId) && isValidShiftReport(incoming()) && incoming().userId == existing().userId;
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(shiftId);
      }

      match /stock_movements/{movementId} {
        allow get: if isSignedIn() && request.auth.uid == userId && isValidId(movementId);
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(movementId) && incoming().userId == request.auth.uid && isValidStockMovement(incoming());
        allow update: if isSignedIn() && request.auth.uid == userId && isValidId(movementId) && isValidStockMovement(incoming()) && incoming().userId == existing().userId;
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(movementId);
      }

      match /receipt_templates/{templateId} {
        allow get: if isSignedIn() && request.auth.uid == userId && isValidId(templateId);
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(templateId) && incoming().userId == request.auth.uid && isValidReceiptTemplate(incoming());
        allow update: if isSignedIn() && request.auth.uid == userId && isValidId(templateId) && isValidReceiptTemplate(incoming()) && incoming().userId == existing().userId;
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(templateId);
      }
    }
  }
}
